<!DOCTYPE html>
[%
  INCLUDE 'include/doc-head-copyright.inc.tt2'
  author_year='2025'
  author_name='PerplexedTheta'
%]
[% INCLUDE 'include/doc-head-start.inc.tt2' %]
<base href="/">
[%
  INCLUDE 'include/doc-head-close.inc.tt2'
  id="arrivees"
  class="$greyscale"
%]

<div id="loading">
    <span class="dialogue">Loading . . . </span>
</div>

<header>
    <h1>&nbsp;</h1>
</header>

<main></main>

<footer></footer>

[% INCLUDE 'include/doc-body-scripts.inc.tt2' %]
<script type="module">
    import API from './include/js/rail/uk/tiger-api.mjs';
    import UKRail from './include/js/rail/uk/main.mjs';

    const api = new API({ jquery: jQuery, tiploc_id: '[% tiploc_id %]' });
    api.init();

    const ukrail = new UKRail({ mode: 'arrivees', api: api, jquery: jQuery });
    ukrail.init();
    setInterval(
        (() => {
            return ukrail.build();
        }),
        30000
    );
</script>
[% INCLUDE 'include/doc-body-close.inc.tt2' %]
